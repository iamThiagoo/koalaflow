{
  "name": "@koalaflow/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "apps/api/dist",
          "main": "apps/api/src/main.ts",
          "tsConfig": "apps/api/tsconfig.app.json",
          "rootDir": "apps/api/src",
          "assets": [
            "apps/api/src/assets"
          ],
          "clean": true
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/api/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/api/dist/patches",
          "{workspaceRoot}/apps/api/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "dev": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@koalaflow/api:build",
          "runBuildTargetDependencies": false,
          "runtimeArgs": [
            "--env-file-if-exists=apps/api/.env"
          ]
        },
        "configurations": {
          "development": {
            "buildTarget": "@koalaflow/api:build:development"
          },
          "production": {
            "buildTarget": "@koalaflow/api:build:production"
          }
        }
      },
      "test": {
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ]
      },
      "db-migrate": {
        "dependsOn": [
          "build"
        ]
      },
      "db-migration-create": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "db-migrate": "node --env-file-if-exists=.env node_modules/@mikro-orm/cli/cli.js migration:up --config dist/platform/database/mikro-orm.config.js",
    "db-migration-create": "node --env-file-if-exists=.env node_modules/@mikro-orm/cli/cli.js migration:create --config dist/platform/database/mikro-orm.config.js --path src/platform/database/migrations"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1156.0",
    "@better-auth/redis-storage": "1.7.12",
    "@mikro-orm/cli": "^7.2.5",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "better-auth": "1.7.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.6",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.5"
  }
}
